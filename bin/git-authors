#!/usr/bin/env bash

set -eu -o pipefail

name='%an' email='%ae'
case "${1-}" in
    --committer) name='%cn' email='%ce'; shift ;;
esac

git log --format="$name%x09$email" "$@" \
    | sort \
    | uniq -c \
    | sort -rn \
    | sed -E 's/^ *([0-9]+) /\1\t/' \
    | awk -F'\t' -v OFS='\t' '
        { total[$3] += $1; names[$3] = ($3 in names ? names[$3] ", " $2 : $2) }
        END { for (email in total) print total[email], names[email], email }
      ' \
    | sort -rn \
    | pretty --header commits author email
